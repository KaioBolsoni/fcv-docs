        </mxCell>
        <mxCell id="t60" connectable="0" parent="e57" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" value="▼ possui ofertas" vertex="1">
          <mxGeometry relative="1" as="geometry">
