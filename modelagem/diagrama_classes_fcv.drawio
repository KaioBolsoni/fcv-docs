          </mxGeometry>
        </mxCell>
        <mxCell id="e61" edge="1" parent="1" source="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;endFill=0;fontSize=11;exitX=0;exitY=0.4839;exitDx=0;exitDy=0;entryX=1;entryY=0.6383;entryDx=0;entryDy=0;" target="c17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t62" connectable="0" parent="e61" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;" value="1" vertex="1">
          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint x="-22" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t63" connectable="0" parent="e61" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;" value="1..*" vertex="1">
          <mxGeometry relative="1" x="1" as="geometry">
            <mxPoint x="22" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t64" connectable="0" parent="e61" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" value="◀ contém" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n66" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cardinalidade (multiplicidade)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada número na ponta da linha responde:&lt;br&gt;&lt;i&gt;&quot;pegando UM objeto do outro lado, quantos DESTE lado podem estar ligados a ele?&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; = exatamente um (obrigatório)&lt;br&gt;&lt;b&gt;0..1&lt;/b&gt; = nenhum ou um (opcional)&lt;br&gt;&lt;b&gt;0..*&lt;/b&gt; = nenhum ou vários&lt;br&gt;&lt;b&gt;1..*&lt;/b&gt; = pelo menos um, podendo ser vários&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; Colaborador &lt;b&gt;1&lt;/b&gt; ——— &lt;b&gt;0..*&lt;/b&gt; Utilização&lt;br&gt;• 1 colaborador tem nenhuma ou várias utilizações&lt;br&gt;• 1 utilização pertence a exatamente 1 colaborador&lt;br&gt;&lt;br&gt;&lt;b&gt;Tipos de relação&lt;/b&gt; (olhando o máximo de cada ponta):&lt;br&gt;• 1 e 1 → &lt;b&gt;1:1&lt;/b&gt; (Colaborador ↔ Usuário)&lt;br&gt;• 1 e * → &lt;b&gt;1:N&lt;/b&gt; (Colaborador → Utilização)&lt;br&gt;• * e * → &lt;b&gt;N:N&lt;/b&gt;, vira uma classe no meio (Benefício × Conveniado)&lt;br&gt;&lt;br&gt;&lt;b&gt;Mínimo 0 ou 1?&lt;/b&gt; Pergunte: &quot;pode existir um sem o outro?&quot; Se pode, é 0." vertex="1">
          <mxGeometry height="380" width="420" x="40" y="740" as="geometry" />
        </mxCell>
        <mxCell id="h68" parent="1" style="text;html=0;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="O que é cada classe" vertex="1">
          <mxGeometry height="36" width="600" x="40" y="1138" as="geometry" />
        </mxCell>
        <mxCell id="n69" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Usuário&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; guardar a conta de acesso (login) de qualquer pessoa: nome, e-mail e senha. Não sabe se é colaborador, conveniado ou FCV; um usuário da FCV é só um Usuário sem Colaborador nem Conveniado ligado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;maria@fcv.org, funcionária da Fundação, entra no portal web.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="40" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n70" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Perfil de Acesso&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; definir o que cada Usuário pode fazer no sistema, conforme o escopo (FCV, COLABORADOR ou CONVENIADO). &quot;permissoes&quot; é a lista de funcionalidades liberadas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;FCV_ADMINISTRADOR gerencia tudo, inclusive usuários; FCV_OPERADOR cuida do dia a dia, sem gerenciar usuários.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="520" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n71" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Colaborador&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; representar a pessoa que trabalha na Fundação e tem direito aos benefícios. Guarda só os dados do vínculo (matrícula, setor, cargo, admissão); nome e e-mail ficam em Usuário.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;João, matrícula 1234, setor Administrativo, gera o QR Code do vale academia no app.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1000" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n72" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Conveniado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; representar o estabelecimento parceiro que oferece benefícios. É quem lê o QR Code e aprova ou reprova o resgate, pelo app ou pelo totem.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;Farmácia Saúde, categoria farmácia, oferece 20% de desconto aos colaboradores.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1480" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n73" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Benefício&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; cadastrar os benefícios recorrentes da Fundação: o desconto (percentual ou valor fixo) e quantas vezes pode ser usado por período (CALENDARIO_FIXO ou JANELA_MOVEL).&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;Vale academia, 1x por mês, reseta todo dia 1.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1960" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n74" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Benefício × Conveniado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; dizer quais conveniados oferecem cada benefício (a &quot;oferta&quot;). Um benefício pode estar em vários conveniados, e vice-versa (N:N).&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;O desconto em farmácia é ofertado pela Farmácia A e pela Farmácia B.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="40" y="1398" as="geometry" />
        </mxCell>
        <mxCell id="n75" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Campanha / Evento&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; cadastrar ações temporárias da Fundação, com início, fim, público elegível e patrocinador opcional. É o &quot;contêiner&quot; dos itens da campanha.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;Corrida FCV 2026.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="520" y="1398" as="geometry" />
        </mxCell>
        <mxCell id="n76" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Benefício da Campanha&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; cadastrar os itens concedidos dentro de uma campanha. É uma &quot;cópia&quot; de Benefício sem periodicidade (caso único), com limite de quantidade opcional.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;Água mineral na Corrida FCV, limite de 50 copos.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1000" y="1398" as="geometry" />
        </mxCell>
        <mxCell id="n77" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Benefício da Campanha × Conveniado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; dizer quais conveniados oferecem cada item de campanha. Um item pode ter mais de um conveniado ofertando (N:N).&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;A massagem da Corrida FCV é oferecida pela Clínica X.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1480" y="1398" as="geometry" />
        </mxCell>
        <mxCell id="n78" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Utilização&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Serve para&lt;/b&gt; registrar o histórico de cada resgate. Nasce PENDENTE quando o colaborador gera o QR Code; o conveniado aprova ou reprova; só a FCV pode estornar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; &lt;i&gt;João gerou o QR do vale academia, a Academia Y leu no totem e aprovou.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1960" y="1398" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
